<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Chromium / V8 inside Electron -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- We spawn user-configured MCP servers via stdio (Claude Code, npx, etc.).
       Those binaries may not be signed by Astra's developer, so we need to be
       allowed to launch them under hardened runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Outbound HTTP to OpenRouter / Anthropic / OpenAI / ElevenLabs / MCP servers -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- ElevenLabs mic recording (STT) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
